# ── Postgres (live pop_db) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://pop:pop_secret@localhost:5432/pop_db

# ── ZLLAMA (Zscaler internal LLM) — used for extraction + insight ─────────────
ZLLAMA_BASE_URL=https://zllama.corp.zscaler.com
ZLLAMA_API_KEY=sk-QrAi3Ej9sVjf-PSYb1ruBA
ZLLAMA_MODEL=claude-haiku-4-5
ZLLAMA_EXTRACTOR_MODEL=claude-haiku-4-5
# ── Ollama (local) — used for SQLCoder SQL generation only ────────────────────
OLLAMA_HOST=http://localhost:11434
SQL_MODEL=sqlcoder:7b

# ── Pipeline tuning (optional — defaults shown) ───────────────────────────────
MAX_SQL_RETRIES=3
DB_TIMEOUT_MS=30000
DB_ROW_CAP=50000
DEFAULT_LIMIT=10
COMPANY_SCORE_THRESHOLD=0.95
