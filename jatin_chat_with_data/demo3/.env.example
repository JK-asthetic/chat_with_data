# ── Postgres (live pop_db) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/pop_db

# ── ZLLAMA (Zscaler internal LLM) — used for extraction + insight ─────────────
ZLLAMA_BASE_URL=https://zllama.corp.zscaler.com
ZLLAMA_API_KEY=sk-<your-key-here>
ZLLAMA_EXTRACTOR_MODEL=claude-3-5-haiku-20241022   # S1 entity extraction (fast)
ZLLAMA_INSIGHT_MODEL=claude-3-5-haiku-20241022     # S7 streamed insight

# ── Ollama (local) — used for SQLCoder SQL generation only ────────────────────
OLLAMA_HOST=http://localhost:11434
SQL_MODEL=sqlcoder:7b

# ── Pipeline tuning (optional — defaults shown) ───────────────────────────────
MAX_SQL_RETRIES=3
SQL_MAX_TOKENS=1500                                # S5 output budget; 512 truncated CTE queries mid-expression
DB_TIMEOUT_MS=30000
DB_ROW_CAP=50000
DEFAULT_LIMIT=10
COMPANY_SCORE_THRESHOLD=0.95

# ── S0 decomposer (multi-question splitting + follow-up rewrite) ──────────────
ZLLAMA_DECOMPOSER_MODEL=claude-sonnet-4-5          # accuracy matters more than speed here
DECOMPOSER_MAX_PARTS=4                             # hard cap on sub-queries per question
